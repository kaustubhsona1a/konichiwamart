# ==============================================================================
# KONICHIWA MART / BOUTIQUE BEAUTY & COSMETICS D2C ENVIRONMENT VARIABLES
# Copy this file to .env or .env.local and fill in your production credentials.
# ZERO HARDCODED SECRETS: Never commit actual keys or secrets to version control.
# ==============================================================================

# Server & App Environment
APP_URL=

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Auth, & Storage)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=
SUPABASE_URL=

# Public Anon Key (safe for client-side queries protected by RLS)
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Service Role Secret (CRITICAL: Server-side only! Bypasses RLS for webhooks & logistics)
SUPABASE_SERVICE_ROLE_KEY=

# Store Operator Master Password (for admin@konichiwamart.com)
OPERATOR_PASSWORD=

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (Test Mode & Live Mode)
# ------------------------------------------------------------------------------
# Public Key ID (e.g. rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_ID=

# Private Key Secret (Server-side only, used for signature verification)
RAZORPAY_KEY_SECRET=

# Webhook Secret (Configured in Razorpay Dashboard > Settings > Webhooks)
# Used to verify HMAC-SHA256 signature in /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. SHIPROCKET LOGISTICS (Automated Forward Dispatch & AWB Tracking)
# ------------------------------------------------------------------------------
# Registered Shiprocket account email & API user credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Pickup warehouse nickname as configured in Shiprocket Panel (e.g. "Primary Warehouse")
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse

# ------------------------------------------------------------------------------
# 4. RESEND (Automated GST Tax Invoices & Order Confirmation Emails)
# ------------------------------------------------------------------------------
# API Key from Resend Dashboard (https://resend.com)
RESEND_API_KEY=

# Verified sender email address (e.g. orders@konichiwamart.com or info@konichiwamart.com)
RESEND_FROM_EMAIL=Konichiwa Mart <info@konichiwamart.com>
